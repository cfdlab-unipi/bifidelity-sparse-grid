{
    "project_name": "demo_vector2d",
    "output_dir": "output_vector2d",
    "data_dir": "hifi-data",

    "problem_definition": {
        "dim_names": ["x1", "x2"],
        "domains": [
            [0.0, 1.0],
            [0.0, 1.0]
        ],
        "pdfs": ["uniform", "uniform"],
        "output_quantities": [
            {
                "name": "qoi_vec",
                "size": 100,
                "label": "t",
                "pad": 3,
                "plot_indices": [0, 25, 50, 75, 99]
            }
        ]
    },

    "sparse_grid_settings": {
        "base_level": 2,
        "target_level": 3
    },

    "refinement_settings": {
        "refinement_criterion": "qoi_vec",
        "use_auto_budget": true,
        "auto_budget_method": "threshold",
        "auto_budget_threshold": 0.10,
        "max_budget": 12
    },

    "plotting": {
        "plot_resolution": 40,
        "slices_2d": [
            {"fixed": {}, "varying": ["x1", "x2"]}
        ],
        "plot_quantities": ["qoi_vec"]
    },

    "statistics": {
        "enabled": true,
        "export_lagrange_coeffs": false,
        "plot_vector_mean_std": true,
        "quantiles": [0.05, 0.5, 0.95],
        "quad_order": 200,
        "vector_metrics": ["l2", "mean", "rms", "max"],
        "exceedance": []
    }
}
