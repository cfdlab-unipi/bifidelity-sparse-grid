{
    "project_name": "analisi_informed_22_01_2026",
    "output_dir": "output",
    "data_dir": "hifi-data",

    "problem_definition": {
        "dim_names": ["y1", "y2", "y3"],
        "domains": [
            [20, 140],
            [0.03, 0.07],
            [1, 6]
        ],
        "output_quantities": [{
            "name": "kurt_mean",
            "size": 1000,
            "label": "p",
            "pad": 4,
            "plot_indices": [0, 10, 999]
        }]
    },

    "sparse_grid_settings": {
        "base_level": 2,
        "target_level": 3
    },

    "refinement_settings": {
        "refinement_criterion": "kurt_mean",
        "use_auto_budget": true,
        "auto_budget_method": "threshold",
        "auto_budget_threshold": 0.05,
        "max_budget": 15
    },
    
    "validation": {
        "validation_data_file": "validation-data.dat" 
    },

    "plotting": {
        "plot_resolution": 50,
        "slices_2d": [
            {"fixed": {"y3": 1},
             "varying": ["y1", "y2"]}
        ]
    }
}
